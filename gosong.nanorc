syntax "gosong" "\.gs$"

# Keywords
color brightblue "\<(fnc|if|but|else|match|for|in|break|continue|return)\>"
color brightblue "\<(error|try|import|use|make|spawn|wait|start|then|startif|elstart)\>"

# Booleans and null
color brightmagenta "\<(true|false|null|_)\>"

# Strings
color green ""([^"\]|\\.)*""

# Comments
color brightblack "//.*" "#.*"
color brightblack start="/\*" end="\*/"

# Numbers
color yellow "\<[0-9]+(\.[0-9]+)?\>"

# Function calls
color cyan "[a-zA-Z_][a-zA-Z0-9_]*\("

# Struct/method markers
color brightyellow "\<(id::[0-9]+)\>"

# Braces
color brightwhite "[{}]"
